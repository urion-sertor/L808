# Copia este archivo como .env y ajusta los valores si hace falta.
# Con XAMPP por defecto: usuario root y sin contraseña.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=l808

# Clave para firmar los tokens de login (JWT). Pon una frase larga.
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta
JWT_EXPIRE_MIN=120
